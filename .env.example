# ---- API (apps/api) ----
DATABASE_URL=postgres://postgres@127.0.0.1:54329/jathara
PORT=4000
# dev = locally signed tokens (never in staging/production); supabase = verify Supabase Auth JWTs via JWKS
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-dev-only-secret-at-least-32-chars
SUPABASE_URL=
# Server-side only (never NEXT_PUBLIC_*): reads authoritative email/phone confirmation from Supabase Auth
SUPABASE_SERVICE_ROLE_KEY=
# Require aal2 (MFA) tokens for admin, management and customer-support roles
REQUIRE_STAFF_MFA=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# ---- Web apps (apps/web, apps/console) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
